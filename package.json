{
	"name": "@openmeteo/weather-map-layer",
	"type": "module",
	"types": "dist/index.d.ts",
	"author": "Open-Meteo <info@open-meteo.com>",
	"version": "0.2.0",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/open-meteo/weather-map-layer.git"
	},
	"description": "Weather Map Layer for MapLibre/Mapbox GL JS powered by Open-Meteo OMfiles",
	"keywords": [
		"openmeteo",
		"open-meteo",
		"meteorological-data",
		"weather-maps",
		"omfile"
	],
	"files": [
		"dist/**/*"
	],
	"watch": {
		"generate:colorscales": {
			"patterns": [
				"scripts/generate-colorscales.ts"
			],
			"extensions": "ts",
			"ignore": [
				"**/node_modules/**",
				"**/dist/**"
			]
		}
	},
	"scripts": {
		"dev": "vite build --watch",
		"test": "vitest",
		"bench": "vitest bench --run",
		"coverage": "vitest run --coverage",
		"lint": "prettier --check . && eslint .",
		"generate:colorscales": "tsx scripts/generate-colorscales.ts && prettier --write src/utils/color-scales.ts",
		"generate:footprints": "tsx scripts/generate-domain-footprints.ts && prettier --write src/domain-footprints.ts",
		"watch:colorscales": "npm-watch generate:colorscales",
		"build": "vite build",
		"prepare": "npm run build",
		"serve": "concurrently --kill-others \"npm run dev\" \"node scripts/serve-examples.js\""
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"@types/d3-interpolate": "^3.0.4",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.0.0",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@typescript-eslint/parser": "^8.46.2",
		"@vitest/coverage-v8": "^5.0.0",
		"concurrently": "^10.0.1",
		"d3-color": "^3.1.0",
		"d3-interpolate": "^3.0.1",
		"eslint": "^10.0.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.0.0",
		"jiti": "^2.6.1",
		"live-server": "^1.2.2",
		"npm-watch": "^0.13.0",
		"prettier": "^3.6.2",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.1",
		"unplugin-dts": "^1.0.0-beta.6",
		"vite": "^8.0.12",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@mapbox/tilebelt": "^2.0.3",
		"@mapbox/vector-tile": "^3.0.0",
		"@openmeteo/file-reader": "^0.0.20",
		"maplibre-gl": "^6.5.0",
		"pbf": "^5.1.0",
		"point-in-polygon-hao": "^1.2.4"
	}
}
